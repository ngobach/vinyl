{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@emotion/react",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
  },
  "include": [
    "src"
  ]
}
